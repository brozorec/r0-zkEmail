# Proof Processor Configuration

[processor]
# Directory to watch for new receipt files
proof_dir = "./proofs"

# Directory where successfully processed receipts are moved
processed_dir = "./proofs/processed"

# Directory where failed receipts are moved
failed_dir = "./proofs/failed"

# How often to scan for new receipts (in seconds)
scan_interval_secs = 60

# Number of retry attempts for failed operations
retry_attempts = 3

# Delay between retry attempts (in seconds)
retry_delay_secs = 5

[stellar]
# Stellar network: testnet, futurenet, or mainnet
network = "testnet"

# EmailPaymentGateway contract address
contract_address = "CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

[relayer]
# OpenZeppelin relayer API URL
api_url = "https://channels.openzeppelin.com/testnet"

# OpenZeppelin relayer API key
api_key = "your-api-key-here"
